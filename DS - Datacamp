# 1. Cargar conjuntos de datos
train = pd.read_csv('train.csv')
validation = pd.read_csv('validation.csv')

# 2. Filtrar precios negativos en entrenamiento si existen
if 'sale_price' in train.columns:
    train = train[train['sale_price'] >= 0]

# 3. Mapeos y conversiones comunes
city_mapping = {'Teasdale': 0, 'Silvertown': 1, 'Poppleton': 2, 'Riverford': 3}
house_type_mapping = {'Detached': 0, 'Semi-detached': 1, 'Terraced': 2, 'Det.': 0, 'Semi': 1, 'Terr.': 2}

for df in [train, validation]:
    if 'city' in df.columns:
        df['city'] = df['city'].map(city_mapping)
    if 'house_type' in df.columns:
        df['house_type'] = df['house_type'].map(house_type_mapping)
    
    # Limpiar 'area' si viene con texto
    if 'area' in df.columns and df['area'].dtype == object:
        df['area'] = df['area'].str.replace(' sq.m.', '', regex=False).astype(float)
        
    # Extraer fechas si existe la columna
    if 'sale_date' in df.columns:
        df['sale_date'] = pd.to_datetime(df['sale_date'])
        df['day'] = df['sale_date'].dt.day
        df['month'] = df['sale_date'].dt.month
        df['year'] = df['sale_date'].dt.year

# 4. Definir X e y excluyendo columnas innecesarias
cols_to_drop = ['index', 'house_id', 'sale_price', 'sale_date']
